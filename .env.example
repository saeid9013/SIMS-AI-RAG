# Copy to .env, load explicitly in shell or Docker Compose. Never commit .env.
SIMS_DATA_DIR=data
SIMS_COOKIE_SECURE=false
SIMS_MAX_UPLOAD_MB=40
SIMS_MAX_PAGES=1000
SIMS_OLLAMA_URL=http://127.0.0.1:11434
# Explicitly install/copy the full E5 model folder first. Empty = lexical-only.
SIMS_EMBED_MODEL_PATH=
SIMS_SEMANTIC_THRESHOLD=0.40
SIMS_ONLINE_BASE_URL=https://api.openai.com/v1
SIMS_ONLINE_API_KEY=
# Optional learning / reranking (all model paths must already exist locally).
SIMS_RERANK_MODEL_PATH=
SIMS_RERANK_MIN_SCORE=
SIMS_EMBED_QUERY_PREFIX='query: '
SIMS_EMBED_PASSAGE_PREFIX='passage: '
SIMS_EMBED_VERSION=1
SIMS_TRAIN_BASE_MODEL_PATH=
SIMS_TRAIN_DEVICE=cuda
SIMS_TRAIN_CPU_MAX_PARAMS=500000000
SIMS_TRAIN_MAX_CHUNKS=200
SIMS_TRAIN_MAX_STEPS=100
SIMS_TRAIN_TIMEOUT_SECONDS=14400
SIMS_ADAPTER_URL=http://127.0.0.1:8001
